# Copia este archivo a ".env" (en la raíz del proyecto) y coloca aquí tus
# credenciales reales de Supabase. Las encuentras en:
# Supabase -> tu proyecto -> Settings -> API
#
# VITE_SUPABASE_URL      -> "Project URL"
# VITE_SUPABASE_ANON_KEY -> "anon public" key
#
# NO subas el archivo ".env" real a ningún repositorio público.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
